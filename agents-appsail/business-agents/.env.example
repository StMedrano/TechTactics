APP_MODE=catalyst
PORT=9000
X_ZOHO_CATALYST_LISTEN_PORT=

# Required in production. Send as: Authorization: Bearer <AGENTS_SHARED_SECRET>
AGENTS_SHARED_SECRET=change-this-long-random-secret

# Optional allowlist for portal/admin origins.
CLIENT_ORIGINS=https://portal.mytechtactics.com,https://www.mytechtactics.com

# Existing portal API, used when the agents need to call back into the main portal.
PORTAL_API_BASE_URL=https://portalappsail-10124080596.development.catalystappsail.com/api
PORTAL_AGENT_WEBHOOK_SECRET=

# Catalyst table names.
CATALYST_TABLE_USERS=Users
CATALYST_TABLE_TICKETS=Tickets
CATALYST_TABLE_SERVICES=Services
CATALYST_TABLE_INVOICES=Invoices
CATALYST_TABLE_LEADS=Leads
CATALYST_TABLE_CAMPAIGNS=Campaigns
CATALYST_TABLE_CAMPAIGN_ASSETS=Campaign_Assets
CATALYST_TABLE_AGENT_TASKS=Agent_Tasks
CATALYST_TABLE_AGENT_ACTIVITY_LOG=Agent_Activity_Log
CATALYST_TABLE_LEAD_FOLLOWUPS=Lead_Followups
CATALYST_TABLE_REVIEWS=Reviews

# Automation controls.
AGENTS_AUTORUN_ENABLED=false
AGENTS_DEFAULT_DRY_RUN=false
AGENTS_MAX_TASKS_PER_RUN=25

# Business defaults.
BUSINESS_NAME=TechTactics
BUSINESS_EMAIL=portal@mytechtactics.com
BUSINESS_PHONE=225-210-9890
BUSINESS_SERVICE_AREA=Baton Rouge and surrounding areas
