# Gemini API credential used by both general AI tasks and lead scouting.
GEMINI_API_KEY=

# High-volume default for sales assets, Zoho orchestration, summaries, and demo copy.
# Your current quota: 15 RPM / 250K TPM / 500 RPD.
GEMINI_MODEL=gemini-3.5-flash-lite

# Dedicated scouting model for Google Search grounding.
# Your current quota: 10 RPM / 250K TPM / 20 RPD.
WGA_SCOUT_MODEL=gemini-2.5-flash-lite

# Lead discovery: auto = Gemini Search first, OpenStreetMap Overpass fallback.
# Other values: gemini, osm
WGA_SCOUT_SOURCE=auto

# OpenStreetMap Overpass fallback endpoint. No Maps/Places API key is required.
WGA_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Runtime
# Keep 127.0.0.1 for local execution. Use 0.0.0.0 inside Docker.
WGA_HOST=127.0.0.1
WGA_PORT=4317
WGA_DATA_DIR=./data
WGA_ARTIFACT_DIR=./artifacts

# Optional comma-separated defaults
WGA_DEFAULT_MARKETS=Prairieville LA,Baton Rouge LA,Gonzales LA
WGA_DEFAULT_CATEGORIES=plumber,hvac,electrician,landscaper,roofing contractor,auto repair,salon,barber,accountant

# Zoho Mail MCP
# Treat the generated MCP URL as a secret; it may contain a credential/key.
ZOHO_MCP_URL=

# Optional role mailboxes/aliases for internal agent-to-agent messages.
WGA_MANAGER_EMAIL=
WGA_SCOUT_EMAIL=
WGA_AUDITOR_EMAIL=
WGA_DESIGNER_EMAIL=
WGA_SALES_EMAIL=

# Zoho Books MCP — Accounting/Tax Assistant
ZOHO_BOOKS_MCP_URL=

# Comma-separated read-only Zoho Books MCP tool names selected in your Zoho MCP server.
WGA_ZOHO_BOOKS_READ_TOOLS=

# Back-office agent mailboxes/aliases
WGA_ACCOUNTING_EMAIL=
WGA_LEGAL_EMAIL=
