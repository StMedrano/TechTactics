# Gemini API credential used by general AI tasks and optional web-search scouting.
GEMINI_API_KEY=

# High-volume default for sales assets, Zoho orchestration, summaries, and demo copy.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Gemini scouting model. Auto mode uses Gemini to supplement sparse OSM results.
WGA_SCOUT_MODEL=gemini-3.5-flash-lite

# Lead discovery: auto = OpenStreetMap first, then Gemini supplements sparse results when available.
# Other values: gemini, osm
WGA_SCOUT_SOURCE=auto

# OpenStreetMap services. No Maps/Places API key is required.
# Comma-separated Overpass endpoints are tried in order so one overloaded public server does not stop scouting.
WGA_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
WGA_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Radius used around the resolved market coordinate for OSM business discovery.
# 25000 is the default; 40000 can be useful for a wider Prairieville/Baton Rouge/Gonzales search area.
WGA_OSM_RADIUS_METERS=25000

# Runtime
# Keep 127.0.0.1 for local execution. Use 0.0.0.0 inside Docker.
WGA_HOST=127.0.0.1
WGA_PORT=4317
WGA_DATA_DIR=./data
WGA_ARTIFACT_DIR=./artifacts

# Optional comma-separated defaults
WGA_DEFAULT_MARKETS=Prairieville LA,Baton Rouge LA,Gonzales LA
WGA_DEFAULT_CATEGORIES=plumber,hvac,electrician,landscaper,roofing contractor,auto repair,salon,barber,accountant

# Zoho Mail MCP
# Treat the generated MCP URL as a secret; it may contain a credential/key.
ZOHO_MCP_URL=

# Optional role mailboxes/aliases for internal agent-to-agent messages.
WGA_MANAGER_EMAIL=
WGA_SCOUT_EMAIL=
WGA_AUDITOR_EMAIL=
WGA_DESIGNER_EMAIL=
WGA_SALES_EMAIL=

# Zoho Books MCP — Accounting/Tax Assistant
ZOHO_BOOKS_MCP_URL=

# Comma-separated read-only Zoho Books MCP tool names selected in your Zoho MCP server.
WGA_ZOHO_BOOKS_READ_TOOLS=

# Back-office agent mailboxes/aliases
WGA_ACCOUNTING_EMAIL=
WGA_LEGAL_EMAIL=
