# Required for live business scouting
GOOGLE_PLACES_API_KEY=

# Required only for AI-generated summaries, outreach, proposals, and demo copy
OPENAI_API_KEY=

# Cost-conscious default; override when desired
OPENAI_MODEL=gpt-5.6-luna

# Runtime
WGA_PORT=4317
WGA_DATA_DIR=./data
WGA_ARTIFACT_DIR=./artifacts

# Optional comma-separated defaults
WGA_DEFAULT_MARKETS=Prairieville LA,Baton Rouge LA,Gonzales LA
WGA_DEFAULT_CATEGORIES=plumber,hvac,electrician,landscaper,roofing contractor,auto repair,salon,barber,accountant


# Zoho Mail MCP
# Treat the generated MCP URL as a secret; it may contain a credential/key.
ZOHO_MCP_URL=

# Optional role mailboxes/aliases for internal agent-to-agent messages.
# These addresses are allow-listed destinations for the agent-mail command.
WGA_MANAGER_EMAIL=
WGA_SCOUT_EMAIL=
WGA_AUDITOR_EMAIL=
WGA_DESIGNER_EMAIL=
WGA_SALES_EMAIL=


# Zoho Books MCP — Accounting/Tax Assistant
# Create a separate Zoho Books MCP server/connection and keep the generated URL secret.
ZOHO_BOOKS_MCP_URL=

# Comma-separated read-only Zoho Books MCP tool names selected in your Zoho MCP server.
# Keep this list read-only. Examples should be copied from the actual tool list exposed by your server.
WGA_ZOHO_BOOKS_READ_TOOLS=

# Back-office agent mailboxes/aliases
WGA_ACCOUNTING_EMAIL=
WGA_LEGAL_EMAIL=
