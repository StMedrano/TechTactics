# Required for Twilio signature validation
TWILIO_AUTH_TOKEN=

# Public AppSail URL after deployment, for example:
# https://your-service-12345.development.catalystappsail.com
PUBLIC_BASE_URL=

# Optional ChatGPT/OpenAI classifier. If empty, the app uses built-in keyword classification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional forwarding for emergency calls
EMERGENCY_FORWARD_NUMBER=

# Optional Twilio voice customization. Default is alice.
# Examples: alice, Polly.Joanna, Polly.Matthew
TWILIO_VOICE=alice
TWILIO_LANGUAGE=

# Catalyst table name
CATALYST_LEADS_TABLE=ReceptionistLeads
CATALYST_TABLE_USERS=Users
CATALYST_TABLE_TICKETS=Tickets

# Zoho Books customer contact creation through Catalyst Connections
ZOHO_BOOKS_CONNECTION_LINK_NAME=books
ZOHO_ORGANIZATION_ID=
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_BOOKS_CONTACTS_PATH=/books/v3/contacts

# Local development only. Do not enable either setting in Catalyst production.
SKIP_TWILIO_VALIDATION=false
USE_MEMORY_STORE=false
PORT=3000
