APP_MODE=demo
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_me

# Zoho Catalyst
CATALYST_PROJECT_ID=
CATALYST_PROJECT_KEY=
CATALYST_PROJECT_ENV=Development
CATALYST_APP_CLIENT_ID=
CATALYST_APP_CLIENT_SECRET=
CATALYST_APP_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Data table names
CATALYST_TABLE_USERS=Users
CATALYST_TABLE_SERVICES=Services
CATALYST_TABLE_TICKETS=Tickets
CATALYST_TABLE_TIME_ENTRIES=TimeEntries
CATALYST_TABLE_PAYMENTS=Payments
CATALYST_TABLE_INVOICES=Invoices
CATALYST_TABLE_SETTINGS=Settings

# Zoho Books / OAuth
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_BOOKS_CONNECTION_LINK_NAME=books
ZOHO_DIRECTORY_CONNECTION_LINK_NAME=directory
ZOHO_DIRECTORY_API_BASE_URL=https://directory.zoho.com
ZOHO_DIRECTORY_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/oauth/callback
ZOHO_SSO_REDIRECT_URI=http://localhost:4000/api/auth/zoho/callback
ZOHO_SSO_SCOPE=openid,email,profile
ZOHO_DIRECTORY_CLIENT_ID=
ZOHO_DIRECTORY_CLIENT_SECRET=
ZOHO_DIRECTORY_AUTH_URL=
ZOHO_DIRECTORY_TOKEN_URL=
ZOHO_DIRECTORY_USERINFO_URL=
ZOHO_DIRECTORY_REDIRECT_URI=http://localhost:4000/api/auth/directory/callback
ZOHO_DIRECTORY_SCOPE=openid email profile
ZOHO_DIRECTORY_SAML_ENTRY_POINT=
ZOHO_DIRECTORY_SAML_IDP_CERT=
ZOHO_DIRECTORY_SAML_ISSUER=
ZOHO_DIRECTORY_SAML_AUDIENCE=
ZOHO_DIRECTORY_SAML_CALLBACK_URL=http://localhost:4000/api/auth/saml/callback
ZOHO_DIRECTORY_SAML_IDENTIFIER_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
ZOHO_DIRECTORY_SAML_PRIVATE_KEY=
ZOHO_DIRECTORY_SAML_PUBLIC_CERT=
ZOHO_ORGANIZATION_ID=
ZOHO_BOOKS_SCOPE=ZohoBooks.fullaccess.all
ZOHO_BOOKS_INVOICE_PATH=/books/v3/invoices
ZOHO_BOOKS_CONTACTS_PATH=/books/v3/contacts

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_DEFAULT_COUNTRY_CODE=+1

# Catalyst Mail / portal email
PORTAL_MAIL_ENABLED=true
PORTAL_MAIL_PROVIDER=auto
PORTAL_EMAIL_FROM=portal@mytechtactics.com
PORTAL_EMAIL_DISPLAY_NAME=TechTactics Portal
PORTAL_EMAIL_REPLY_TO=portal@mytechtactics.com
PORTAL_EMAIL_GROUP=portal@mytechtactics.com
ZOHO_MAIL_HOST=smtp.zoho.com
ZOHO_MAIL_PORT=465
ZOHO_MAIL_SECURE=true
ZOHO_MAIL_USER=
ZOHO_MAIL_PASS=
ZOHO_MAIL_FROM=TechTactics Portal <portal@mytechtactics.com>

# PWA device push notifications
DEVICE_PUSH_ENABLED=true
WEB_PUSH_VAPID_SUBJECT=mailto:portal@mytechtactics.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
